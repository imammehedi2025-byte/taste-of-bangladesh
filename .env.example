# Firebase web app config (Project settings → General → Your apps → SDK setup and configuration).
# These are public client identifiers, not secrets. Data is protected by firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Public URL of your deployment, used in share text and on PNG cards (no trailing slash).
VITE_SITE_URL=https://taste-of-bangladesh.vercel.app
